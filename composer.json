{
	"name": "mhm/pro-kit",
	"description": "Shared Pro-only admin UI for MHM plugins: the license page body and the license key mask. Never required by a free plugin.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/MaxHandMade/mhm-ui-core",
			"no-api": true
		}
	],
	"require": {
		"php": ">=8.1",
		"mhm/ui-core": ">=0.23 <1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"phpstan/phpstan": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^7.1",
		"squizlabs/php_codesniffer": "^3.13.6",
		"wp-coding-standards/wpcs": "^3.4.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"files": [
			"src/mask.php"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "@php ./vendor/bin/phpunit -c phpunit.xml",
		"phpcs": "@php ./vendor/bin/phpcs --standard=phpcs.xml",
		"phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
		"check": [
			"@phpcs",
			"@phpstan",
			"@test"
		]
	}
}
